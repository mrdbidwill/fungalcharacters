# Copy to .env on the server and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-50-random-characters
DJANGO_ALLOWED_HOSTS=fungalcharacters.org
CSRF_TRUSTED_ORIGINS=https://fungalcharacters.org
SITE_PROTOCOL=https
SECURE_HSTS_SECONDS=3600
DJANGO_ADMINS=
POSTGRES_PASSWORD=change-me
DATABASE_PASSWORD=change-me
# Email: Resend SMTP (domain mail.fungalcharacters.org). Password = a Resend API key with sending access.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fungal Characters <no-reply@mail.fungalcharacters.org>
