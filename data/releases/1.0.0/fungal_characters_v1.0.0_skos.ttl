    skos:inScheme fc:scheme ;
    skos:notation "FCV00133" ;
    skos:prefLabel "Velvety - Hairy"@en .

fc:FCV00134 a skos:Concept ;
    skos:definition "Hairy - A surface cover with fuzz or fine hairs."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00134" ;
    skos:prefLabel "Pubescent - Hairy"@en .

fc:FCV00135 a skos:Concept ;
    skos:definition "Hairy - A surface covered in dense white or gray down-like hairs. Giving a frosted appearance."@en ;
