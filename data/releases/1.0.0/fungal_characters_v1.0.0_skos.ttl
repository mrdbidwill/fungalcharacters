fc:FCV00136 a skos:Concept ;
    skos:definition "Hairy - A surface covered in Wooly or cotton-like hairs."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00136" ;
    skos:prefLabel "Floccose - Hairy"@en .

fc:FCV00137 a skos:Concept ;
    skos:definition "Hairy - A surface covered densely with matted hairs."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00137" ;
    skos:prefLabel "Tomentose - Hairy"@en .

fc:FCV00138 a skos:Concept ;
    skos:definition "Hairy - A surface covered with straight bristle-like hairs."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00138" ;
    skos:prefLabel "Hispid - Hairy"@en .

fc:FCV00139 a skos:Concept ;
    skos:definition "Hairy - A surface covered with slightly stiff and shaggy hairs."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00139" ;
    skos:prefLabel "Hirsute - Hairy"@en .

fc:FCV00140 a skos:Concept ;
    skos:definition "Hairy - A surface covered with long soft hairs."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00140" ;
    skos:prefLabel "Villose - Hairy"@en .

fc:FCV00141 a skos:Concept ;
