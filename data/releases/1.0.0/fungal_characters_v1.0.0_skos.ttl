fc:FCV00143 a skos:Concept ;
    skos:definition "The margins curve slightly downwards."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00143" ;
    skos:prefLabel "Decurved"@en .

fc:FCV00144 a skos:Concept ;
    skos:definition "The margins curve down and inwards."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00144" ;
    skos:prefLabel "Incurved"@en .

fc:FCV00145 a skos:Concept ;
    skos:definition "The margins curve downwards and roll inwards. Also known as inrolled."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00145" ;
    skos:prefLabel "Involute"@en .

fc:FCV00146 a skos:Concept ;
    skos:definition "The margins curve upwards between the edge and stem."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00146" ;
    skos:prefLabel "Arched"@en .

fc:FCV00147 a skos:Concept ;
    skos:definition "The margins curve upwards. Also known as elevated."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00147" ;
    skos:prefLabel "Uplifted"@en .

fc:FCV00148 a skos:Concept ;
    skos:definition "The margins curve inwards and also rolled back.."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00148" ;
    skos:prefLabel "Revolute"@en .

fc:FCV00149 a skos:Concept ;
    skos:definition "The margins extend past the gills."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00149" ;
    skos:prefLabel "Exceeding"@en .

fc:FCV00150 a skos:Concept ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00150" ;
    skos:prefLabel "Straight"@en .

fc:FCV00151 a skos:Concept ;
    skos:definition "Also called: Wavy"@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00151" ;
    skos:prefLabel "Undulating"@en .

fc:FCV00152 a skos:Concept ;
    skos:definition "Remnants of a partial veil hang from the edge of the cap."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00152" ;
    skos:prefLabel "Appendiculate"@en .

fc:FCV00153 a skos:Concept ;
    skos:definition "Also called: Encurved"@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00153" ;
    skos:prefLabel "Incurved"@en .

fc:FCV00154 a skos:Concept ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00154" ;
    skos:prefLabel "Decurved"@en .

fc:FCV00155 a skos:Concept ;
    skos:definition "Also called: Inrolled"@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00155" ;
    skos:prefLabel "Involute"@en .

fc:FCV00156 a skos:Concept ;
    skos:definition "Also called: Fringed"@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00156" ;
    skos:prefLabel "Ciliate"@en .

fc:FCV00157 a skos:Concept ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00157" ;
    skos:prefLabel "Arched"@en .

fc:FCV00158 a skos:Concept ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00158" ;
    skos:prefLabel "Uplifted"@en .

fc:FCV00159 a skos:Concept ;
    skos:definition "Also called: Rolled Back"@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00159" ;
    skos:prefLabel "Revolute"@en .

fc:FCV00160 a skos:Concept ;
    skos:definition "The edges of the cap are split apart or full of large crevices. Also referred to as cracked or rimose."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00160" ;
    skos:prefLabel "Split"@en .

fc:FCV00161 a skos:Concept ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00161" ;
    skos:prefLabel "Exceeding Gills"@en .

fc:FCV00162 a skos:Concept ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00162" ;
    skos:prefLabel "Serrate"@en .

fc:FCV00163 a skos:Concept ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00163" ;
    skos:prefLabel "Other"@en .

fc:FCV00164 a skos:Concept ;
    skos:definition "There is a smooth transition from the top of the cap to its underside. No irregular attributes should be present on the edges. Also referred to as Smooth, Even, Seamless, Flush, or Regular."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00164" ;
    skos:prefLabel "Entire"@en .

fc:FCV00165 a skos:Concept ;
    skos:definition "Fine and narrow stripes run parallel on the cap margins. The lines will often coincide with the gills underneath the cap. In some cases, the lines are only visible when the cap is wet. Also referred to as striped, furrowed, streaked, ribbed, lined,"@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00165" ;
    skos:prefLabel "Striate"@en .

fc:FCV00166 a skos:Concept ;
    skos:definition "Narrow parallel grooves that line the margins of the cap. Sulcate margins are more defined than striate but less ridged than plicated. Also referred to as plicate-striate."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00166" ;
    skos:prefLabel "Sulcate"@en .

fc:FCV00167 a skos:Concept ;
    skos:definition "Parallel pleated margins. They are best described as fan-like or umbrella-like as if the surface of the cap were folded. Plicate margins are more defined and ridged than Striate or Sulcate. Also referred to as pleated or ridged."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00167" ;
    skos:prefLabel "Plicate"@en .

fc:FCV00168 a skos:Concept ;
    skos:definition "Deteriorated, gnawed, or eaten away. The disfigured margins are usually found in older specimens and are the result of insects or deliquescence (common with Ink Caps). Also referred to as gnawed or ragged."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00168" ;
    skos:prefLabel "Eroded"@en .

fc:FCV00169 a skos:Concept ;
    skos:definition "Many tears mark the edge of the cap. Similar to split margins, however, the cuts are smaller and more frequent. Also referred to as torn."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00169" ;
    skos:prefLabel "Lacerate"@en .

fc:FCV00170 a skos:Concept ;
    skos:definition "Hairy - The edges of the cap form a wave-like pattern as they rise and fall. Also referred to as wavy irregular or festoony."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00170" ;
    skos:prefLabel "Undulating - Hairy"@en .

fc:FCV00171 a skos:Concept ;
    skos:definition "Hairy - Semi-circle notches or round-toothed edges that are more blunted than serrate margins. Also referred to as scalloped."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00171" ;
    skos:prefLabel "Crenate - Hairy"@en .

fc:FCV00172 a skos:Concept ;
    skos:definition "Hairy - The edges of the cap appear jagged and saw-toothed. More pronounced than crenate margins."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCV00172" ;
    skos:prefLabel "Serrate - Hairy"@en .

