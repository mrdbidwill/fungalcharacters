        fc:FCV00478,
        fc:FCV00479,
        fc:FCV00480,
        fc:FCV00481,
        fc:FCV00482,
        fc:FCV00483,
        fc:FCV00484 ;
    skos:prefLabel "Aroma values"@en .

fc:FCC00283 a skos:Concept ;
    skos:altLabel "Odor When Rubbed"@en ;
    skos:definition "The first thing that can be done after photography is an aroma test. Smell the mushroom as it is. Then, briefly rub a mushroom cap and the stem and smell again. You can also cut the mushroom and immediately perform a smell test. Record these aromas (almond-like, bakery-like, like dark cacao chocolate, apricot-like, like frozen orange juice, “normal/common,” cucumber-like, anise-like, garlic-like, coal-tar-like, radish-like, cedar-like, bleach-like, spermatic, shrimp-like, maraschino-cherry-like, acrid, etc.)."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCC00283" ;
    skos:prefLabel "Aroma When Rubbed"@en ;
    skos:scopeNote "Part: Whole Fungus. Method: Aroma and Taste. Data type: odor."@en .

fc:FCC00284 a skos:Concept ;
    skos:altLabel "Odor When Cut"@en ;
    skos:definition "The first thing that can be done after photography is an aroma test. Smell the mushroom as it is. Then, briefly rub a mushroom cap and the stem and smell again. You can also cut the mushroom and immediately perform a smell test. Record these aromas (almond-like, bakery-like, like dark cacao chocolate, apricot-like, like frozen orange juice, “normal/common,” cucumber-like, anise-like, garlic-like, coal-tar-like, radish-like, cedar-like, bleach-like, spermatic, shrimp-like, maraschino-cherry-like, acrid, etc.)."@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCC00284" ;
    skos:prefLabel "Aroma When Cut"@en ;
    skos:scopeNote "Part: Whole Fungus. Method: Aroma and Taste. Data type: odor."@en .

fc:FCC00285 a skos:Concept ;
    skos:definition "The next thing you can do is a taste test. If you have a digestive sensitivity, I cannot ethically recommend performing this test. Do not eat or swallow any material. To conduct the test, nibble a very small piece of mushroom material, and very briefly try to get a flavor description (mildly bitter, acrid, gourmet, spicy, none, common, etc.). All of the material is then spit out. Hands and mouth are then thoroughly rinsed. | Aroma and flavor [See dedicated section further down]"@en ;
    skos:inScheme fc:scheme ;
    skos:notation "FCC00285" ;
    skos:prefLabel "Taste"@en ;
    skos:related fc:FCC00285-values ;
    skos:scopeNote "Part: Whole Fungus. Method: Aroma and Taste. Data type: taste."@en .

